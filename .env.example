# Backend API base URL (no trailing slash)
VITE_API_URL=http://localhost:8000

# App metadata
VITE_APP_NAME=Spenza
VITE_APP_ENV=development

# Analytics year filter (Calendar Heatmap year dropdown)
VITE_ANALYTICS_YEAR_FILTER_COUNT=6
VITE_ANALYTICS_YEAR_FILTER_MIN_YEAR=2020

# Trend Analysis "Yearly" tab — how many calendar years back to show, unaffected by the page's global date filter
VITE_ANALYTICS_TREND_YEARLY_COUNT=6
